  "schema_version": 1,
  "revision": "2026-10-31.6",
  "note": "DPI 模块目录：键与 traffic-engine 的 AppId 一一对应。implemented=已有专用检测器并纳入本地测试；context=仅接收调用方已解密/已解码输入，不直接从线缆识别；candidate=仅有有界结构候选，不计入协议适配完成。",
  "intensities": [
    {
      "key": "off",
      "name": "关闭",
      "inspect_bytes": 0,
      "description": "不执行任何 DPI；记录中的 app.outcome 为 not_inspected，不把未检查写成 unknown。"
    },
    {
      "key": "basic",
      "name": "基础",
      "inspect_bytes": 128,
      "description": "只运行 TLS ClientHello、HTTP 首部、DNS 三个轻量检测器，减少每包拷贝与解析开销。"
    },
    {
      "key": "standard",
      "name": "标准",
      "inspect_bytes": 512,
      "description": "运行全部已启用模块，按首包判定；不启用 TLS 解密。"
    },
    {
      "key": "deep",
      "name": "深度",
      "inspect_bytes": 4096,
      "description": "扩大首包检查窗口，并在配置了 TLS 密钥日志时由 cythsec-tls-inspect 尝试解密 TLS 1.2/1.3 应用数据；开销最高，只建议用于取证点位。"
    }
  ],

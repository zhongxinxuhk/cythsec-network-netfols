# Optional application JSON config. Copy private overrides to config.local.* (gitignored).
# CYTHSEC_MIDDLEWARE_CONFIG=/etc/cythsec/middleware.json
CLICKHOUSE_CLIENT=clickhouse-client
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=flow_records_v2
CLICKHOUSE_SECURE=false
CLICKHOUSE_TIMEOUT=10s
# Set exactly one password source, never pass it as a command-line flag.
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_PASSWORD_FILE=/run/secrets/clickhouse-password

# Naming contract for future clients; these clients are not implemented yet.
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=
# POSTGRES_USER=
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
# POSTGRES_SSLMODE=verify-full
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_DATABASE=0
# REDIS_USER=
# REDIS_PASSWORD_FILE=/run/secrets/redis-password
# REDIS_TLS=true

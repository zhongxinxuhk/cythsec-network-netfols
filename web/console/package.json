{
  "name": "cythsec-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/loopback-only.cjs ./scripts/start-console.cjs dev",
    "build": "npm run typecheck:all && max build",
    "preview": "node --require ./scripts/loopback-only.cjs ./scripts/start-console.cjs preview",
    "typecheck": "max setup && tsc --noEmit",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "prepare": "max setup"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.8",
    "dayjs": "1.11.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@ant-design/pro-components": "3.1.14-2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "7.3.7",
    "vitest": "^4.1.12",
    "@umijs/max": "4.7.27",
    "decode-uri-component": "file:compat/decode-uri-component-cjs",
    "react-router-dom": "file:compat/react-router-dom-compat",
    "node-libs-browser": "file:compat/browser-node-builtins",
    "node-libs-browser-okam": "file:compat/browser-node-builtins"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23",
    "isomorphic-fetch": {
      "node-fetch": "^2.7.0"
    },
    "path-to-regexp@>=1 <1.9.0": "1.9.0",
    "postcss-selector-parser": "^7.1.7",
    "vite": "$vite",
    "@babel/core@<7.29.1": "^7.29.7",
    "@babel/runtime@<7.26.10": "^7.29.7",
    "esbuild@<0.25.0": "^0.25.12",
    "@umijs/bundler-utoopack": {
      "less-loader": "^12.3.3"
    },
    "decode-uri-component": "$decode-uri-component",
    "node-libs-browser": "$node-libs-browser",
    "node-libs-browser-okam": "$node-libs-browser-okam",
    "react-router@>=6 <8": "7.18.4",
    "react-router-dom@>=6 <8": "$react-router-dom"
  }
}

{
  "name": "cythsec-console",
  "version": "0.1.0",
  "private": true,
  "description": "CythSec 管理控制台（Ant Design Pro 完整工程）",
  "repository": "https://github.com/zhongxinxuhk/cythsec-network-netfols.git",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "deploy": "cross-env CI=true max build && gh-pages -d dist",
    "dev": "node scripts/dev.cjs",
    "i18n-remove": "node scripts/i18n-remove.js",
    "lint": "biome lint && npm run lint:business && tsc --noEmit",
    "lint-staged": "lint-staged",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "openapi": "max openapi",
    "prepare": "max setup",
    "preview": "node --require ./scripts/loopback-only.cjs scripts/start-console.cjs preview",
    "preview:build": "max build && npm run preview",
    "record": "cross-env NODE_ENV=development UMI_ENV=test max record --scene=login",
    "simple": "node scripts/simple.js",
    "start": "npm run dev",
    "start:no-mock": "cross-env MOCK=none npm run dev",
    "start:pre": "cross-env UMI_ENV=pre MOCK=none max dev",
    "start:test": "cross-env UMI_ENV=test MOCK=none max dev",
    "test": "npm run test:unit && npm run test:business && npm run test:pro",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui-host=0.0.0.0",
    "e2e:report": "playwright show-report e2e-out/playwright-report",
    "doctor": "react-doctor .",
    "tsc": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "npm run typecheck",
    "typecheck:node": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:pro": "vitest run --config vitest.config.ts",
    "test:business": "vitest run --config vitest.business.config.ts",
    "lint:business": "eslint src/pages/*Page.tsx src/components/*.tsx src/api/*.ts src/hooks/*.ts"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.14-2",
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "^2.9.0",
    "@ant-design/x-sdk": "^2.9.0",
    "@tanstack/react-query": "^5.104.5",
    "antd": "^6.6.7",
    "antd-style": "^4.1.0",
    "china-division": "^2.7.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.7",
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@umijs/lint": "^4.7.27",
    "@umijs/max": "^4.7.27",
    "@umijs/max-plugin-openapi": "^2.0.3",
    "@umijs/request-record": "^1.1.4",
    "@utoo/pack": "1.5.31",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "cross-env": "^10.1.0",
    "decode-uri-component": "file:compat/decode-uri-component-cjs",
    "deepmerge": "file:compat/deepmerge-safe",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "express": "^5.3.0",
    "geojson": "^0.5.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.6.0",
    "mockjs": "file:compat/mockjs-safe",
    "node-libs-browser": "file:compat/browser-node-builtins",
    "node-libs-browser-okam": "file:compat/browser-node-builtins",
    "playwright": "^1.64.1",
    "react-doctor": "^0.9.18",
    "react-router-dom": "file:compat/react-router-dom-compat",
    "swagger-ui-dist": "^5.34.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "overrides": {
    "@umijs/plugins": {
      "@ant-design/pro-components": "$@ant-design/pro-components",
      "axios": "^1.19.0"
    },
    "@umijs/lint": {
      "@babel/core": "^7.29.6"
    },
    "dva-immer": {
      "immer": "^9.0.6"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    },
    "postcss": "^8.5.23",
    "isomorphic-fetch": {
      "node-fetch": "^2.7.0"
    },
    "path-to-regexp@>=1 <1.9.0": "1.9.0",
    "postcss-selector-parser": "^7.1.7",
    "@babel/core@<7.29.1": "^7.29.7",
    "@babel/runtime@<7.26.10": "^7.29.7",
    "esbuild@<0.25.0": "^0.25.12",
    "@umijs/bundler-utoopack": {
      "less-loader": "^12.3.3"
    },
    "decode-uri-component": "$decode-uri-component",
    "node-libs-browser": "$node-libs-browser",
    "node-libs-browser-okam": "$node-libs-browser-okam",
    "react-router@>=6 <8": "7.18.4",
    "react-router-dom@>=6 <8": "$react-router-dom",
    "katex@<0.18.2": "0.18.2",
    "@hono/node-server": "2.1.5",
    "deepmerge": "$deepmerge",
    "mockjs": "$mockjs",
    "vite@>=7 <7.3.7": "7.3.7"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "create-umi": {
    "ignoreScript": [
      "docker*",
      "functions*",
      "site",
      "generateMock"
    ],
    "ignoreDependencies": [
      "netlify*",
      "serverless"
    ],
    "ignore": [
      ".dockerignore",
      ".git",
      ".github",
      ".gitpod.yml",
      "CODE_OF_CONDUCT.md",
      "Dockerfile",
      "Dockerfile.*",
      "lambda",
      "LICENSE",
      "netlify.toml",
      "README.*.md",
      "azure-pipelines.yml",
      "docker",
      "CNAME",
      "create-umi"
    ]
  },
  "antDesignProTemplateVersion": "6.0.3",
  "packageManager": "npm@11.12.1"
}

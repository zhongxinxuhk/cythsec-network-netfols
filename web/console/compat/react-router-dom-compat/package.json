{
  "name": "@cythsec/react-router-dom-compat",
  "version": "1.0.0",
  "private": true,
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./server": {
      "types": "./server.d.ts",
      "import": "./server.mjs",
      "require": "./server.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "router-dom-upstream": "npm:react-router-dom@7.18.4",
    "react-router": "7.18.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}

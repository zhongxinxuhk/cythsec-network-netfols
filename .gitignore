# --- 构建产物 / Build artifacts ---
build/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
out/
dist/
release/

# --- C/C++ ---
*.cmake
CMakeCache.txt
CMakeFiles/
compile_commands.json
.dSYM/

# --- Rust ---
target/
**/*.rs.bk
# Cargo.lock 保留入库：应用类工程（非库）锁定依赖版本，保证可重现构建

# --- Go ---
*.test
*.out
vendor/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
web/console/dist/
web/console/.vite/
# TS 增量编译缓存：随 tsc -b / composite 项目生成，机器相关，不入仓
*.tsbuildinfo

# --- Python (ML) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
ml/**/runs/
ml/**/wandb/

# --- 数据集 / 抓包（体积大、通常不入仓） ---
datasets/**/*.pcap
datasets/**/*.pcapng
datasets/**/*.parquet
datasets/**/*.csv
datasets/**/*.json
!datasets/samples/README.md
capture/**/*.pcap

# --- 编辑器 / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- 密钥 / 本地配置 ---
*.env
*.env.local
secrets/
**/config.local.*

# --- 本地工具状态（Mimosa 审计：finding-ledger / history / hook-state / reports） ---
.mimosa/

# --- 日志 ---
*.log
logs/

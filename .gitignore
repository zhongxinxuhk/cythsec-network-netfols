# --- 构建产物 / Build artifacts ---
build/
cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
out/
dist/
# 只忽略**根目录**的打包输出。此前写的是不带前导斜杠的 `release/`，
# 它按 gitignore 规则匹配**任意层级**名为 release 的目录 —— 于是
# `scripts/release/` 整个被忽略，`check-version.sh`（版本单一真源自检）
# 从未入库：文档、README 都在引用它，`git status` 却看不见它，
# 全新克隆里根本没有这个文件。同类模式（out/、dist/）目前没有撞到
# 真实源码目录，但新增目录前请先 `git check-ignore -v <path>` 确认。
/release/

# --- C/C++ ---
*.cmake
CMakeCache.txt
CMakeFiles/
compile_commands.json
.dSYM/

# --- Rust ---
target/
**/*.rs.bk
# Cargo.lock 保留入库：应用类工程（非库）锁定依赖版本，保证可重现构建

# --- Go ---
*.test
*.out
vendor/

# --- Node / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
web/console/dist/
web/console/.vite/
# TS 增量编译缓存：随 tsc -b / composite 项目生成，机器相关，不入仓
*.tsbuildinfo
# vitest 转译 TS 配置时生成的临时配置（运行后偶有残留，机器相关，不入仓）
*.timestamp-*.mjs

# --- Python (ML) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
ml/**/runs/
ml/**/wandb/

# --- 数据集 / 抓包（体积大、通常不入仓） ---
datasets/**/*.pcap
datasets/**/*.pcapng
datasets/**/*.parquet
datasets/**/*.csv
datasets/**/*.json
!datasets/samples/README.md
capture/**/*.pcap

# --- 编辑器 / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- 密钥 / 本地配置 ---
*.env
*.env.local
secrets/
**/config.local.*

# --- 本地工具状态（Mimosa 审计：finding-ledger / history / hook-state / reports） ---
.mimosa/

# --- 日志 ---
*.log
logs/
